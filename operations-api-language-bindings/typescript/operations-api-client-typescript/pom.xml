<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.platform.operations</groupId>
        <artifactId>operations-api-typescript-bindings</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>operations-api-client-typescript</artifactId>
    <name>ForwardMeasure Platform Operations :: API :: Generated TypeScript Client</name>
    <build>
        <resources>
            <resource>
                <directory>${project.build.directory}/generated-typescript</directory>
                <targetPath>typescript-client</targetPath>
                <excludes><exclude>.openapi-generator/**</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-typescript</id>
                        <phase>generate-resources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../operations-api-specifications/operations-services-api-spec/platform-operations.openapi.yaml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.build.directory}/generated-typescript</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <skipValidateSpec>false</skipValidateSpec>
                            <configOptions>
                                <npmName>@forwardmeasure/platform-operations-client</npmName>
                                <npmVersion>1.0.0</npmVersion>
                                <prefixParameterInterfaces>true</prefixParameterInterfaces>
                                <supportsES6>true</supportsES6>
                                <useSingleRequestParameter>true</useSingleRequestParameter>
                                <withInterfaces>true</withInterfaces>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
