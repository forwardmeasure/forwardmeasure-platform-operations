<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.platform.operations</groupId>
        <artifactId>operations-dashboard</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>operations-dashboard-webapp</artifactId>
    <name>ForwardMeasure Platform Operations :: Dashboard :: Webapp</name>
    <properties>
        <webui-app>src/main/webapp</webui-app>
        <webui-build-dir>${project.build.directory}/webapp</webui-build-dir>
    </properties>
    <dependencies>
        <!-- Build order only: the presentation-system package is unpacked from this artifact below. The pom-type dependency makes the reactor build it first without adding its files to the Java classpath. -->
        <dependency>
          <groupId>com.forwardmeasure.presentation</groupId>
          <artifactId>forwardmeasure-presentation-system-web</artifactId>
          <version>${forwardmeasure.presentation-system.version}</version>
          <type>pom</type>
          <scope>provided</scope>
          <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>operations-api-client-typescript</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- The shared presentation system (tokens, kg- component styles, fonts, theme logic) as
                 an npm package, unpacked into the staged build directory beside the generated API
                 client; package.json depends on it as file:presentation-system-unpacked/... Always
                 overwritten, because the same release version is reinstalled during development. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-presentation-system</id>
                        <phase>initialize</phase>
                        <goals><goal>unpack</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.forwardmeasure.presentation</groupId>
                                    <artifactId>forwardmeasure-presentation-system-web</artifactId>
                                    <version>${forwardmeasure.presentation-system.version}</version>
                                    <includes>presentation-system/**</includes>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${webui-build-dir}/presentation-system-unpacked</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-operations-dashboard-sources</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${webui-build-dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${webui-app}</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>node_modules/**</exclude>
                                        <exclude>build/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-operations-api-typescript-client</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${webui-build-dir}/generated-api</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../operations-api-language-bindings/typescript/operations-api-client-typescript/target/generated-typescript</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-operations-dashboard</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${webui-build-dir}/build</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${webui-build-dir}</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>initialize</phase>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration><nodeVersion>${nodejs.version}</nodeVersion></configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>ci --ignore-scripts</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <phase>test</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>test</arguments><skip>${skipTests}</skip></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
